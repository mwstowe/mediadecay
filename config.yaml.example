plex:
  url: http://127.0.0.1:32400
  token: "YOUR_PLEX_TOKEN"
  user_tokens:
    alice: "ALICE_PLEX_TOKEN"
    bob: "BOB_PLEX_TOKEN"
  user_emails:
    admin: admin@example.com
    alice: alice@example.com
    bob: bob@example.com

sonarr:
  url: http://127.0.0.1:8989
  api_key: "YOUR_SONARR_KEY"

radarr:
  url: http://127.0.0.1:7878
  api_key: "YOUR_RADARR_KEY"

medusa:
  url: http://127.0.0.1:8081
  api_key: "YOUR_MEDUSA_KEY"
  # TLS certificate verification is ON by default. If Medusa serves HTTPS with
  # a self-signed certificate, set this to false to disable verification
  # (insecure — prefer installing a valid/trusted certificate instead).
  # verify_ssl: false

ombi:
  url: http://127.0.0.1:5000
  api_key: "YOUR_OMBI_KEY"

web:
  secret_key: "CHANGE_ME_RANDOM_SECRET"
  admin_password: ""  # bcrypt hash; generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpass', bcrypt.gensalt()).decode())"
  base_url: "https://mediadecay.example.com:9393"
  port: 9393
  ssl_cert: /opt/mediadecay/ssl/fullchain.pem
  ssl_key: /opt/mediadecay/ssl/privkey.pem

notifications:
  enabled: false
  method: email  # email | discord
  email:
    from: mediadecay@example.com
    admin: admin@example.com
    smtp_host: smtp.example.com
    smtp_port: 587
    # TLS mode: starttls (default for 587/25) | ssl (implicit TLS, default for
    # 465) | none (no encryption — only valid when no credentials are set).
    # Credentials are never sent over an unencrypted connection.
    # smtp_tls: starttls
    smtp_user: ""
    smtp_pass: ""
  discord:
    webhook_url: ""

maintenance:
  dry_run: true
  schedule: "03:00"
  log_file: /var/log/mediadecay.log
  remove_empty_collections: true
  excluded_libraries:
    - "3D Movies"

database:
  path: mediadecay.db
